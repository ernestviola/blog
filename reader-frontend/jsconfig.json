{
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@utils/*": ["./src/utils/*/index.jsx", "./src/utils/*"],
      "@components/*": ["./src/components/*/index.jsx", "./src/components/*"],
      "@routes/*": ["./src/routes/*/index.jsx", "./src/routes/*"],
      "@layouts/*": ["./src/layouts/*/index.jsx", "./src/layouts/*"],
      "@contexts/*": ["./src/contexts/*/index.jsx", "./src/contexts/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
