{
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@routes/*": ["./src/routes/*/index.jsx", "./src/routes/*"],
      "@components/*": ["./src/components/*/index.jsx", "./src/components/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
